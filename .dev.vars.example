# For `npm run dev:admin`: the admin Worker's secrets when running locally. Copy to .dev.vars.
SUPABASE_SECRET_KEY=sb_secret_...
RESEND_API_KEY=re_...
CF_API_TOKEN=
GOOGLE_CLIENT_SECRET=
