# The admin app (dist/admin). It talks to Supabase (connect-src), shows photos through signed Supabase links and map tiles from OpenStreetMap (img-src), reads PDFs with pdf.js (its worker, and its WebAssembly image decoders) opens Office files in Microsoft's viewer and shows an email's own page from /api (frame-src).
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  X-Robots-Tag: noindex, nofollow
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; frame-src 'self' https://view.officeapps.live.com; style-src 'self'; img-src 'self' data: blob: https://rqspfymfujfimljgilid.supabase.co https://tile.openstreetmap.org; font-src 'self'; connect-src 'self' https://rqspfymfujfimljgilid.supabase.co wss://rqspfymfujfimljgilid.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# the service worker: always checked, so a deploy reaches everyone
/sw.js
  Cache-Control: no-cache
