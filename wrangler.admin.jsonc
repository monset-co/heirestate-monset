// The private admin at admin.heirestates.com: listings, CRM, dashboard and commission log. A static
// app (dist/admin) that talks to Supabase directly as the signed-in user, where row-level security
// guards the data (supabase/migrations), plus a small Worker for what needs a secret
// (admin/worker). Deployed with `npm run deploy:admin`, before the public sites, which call it
// for inquiries (wrangler.jsonc's ADMIN binding).
//
// Secrets, once each:  npx wrangler secret put SUPABASE_SECRET_KEY -c wrangler.admin.jsonc
//                      npx wrangler secret put RESEND_API_KEY -c wrangler.admin.jsonc
//                      npx wrangler secret put CF_API_TOKEN -c wrangler.admin.jsonc
//                      npx wrangler secret put WA_TOKEN -c wrangler.admin.jsonc         (Meta system user token)
//                      npx wrangler secret put WA_APP_SECRET -c wrangler.admin.jsonc    (Meta app > Settings > Basic)
//                      npx wrangler secret put WA_VERIFY_TOKEN -c wrangler.admin.jsonc  (any long random string, also typed into Meta)
//                      npx wrangler secret put GOOGLE_CLIENT_SECRET -c wrangler.admin.jsonc (the OAuth client's secret)
{
  "name": "heirestates-admin",
  "compatibility_date": "2026-10-01",
  "main": "admin/worker/index.js",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "admin.heirestates.com", "custom_domain": true }],
  "assets": {
    "directory": "dist/admin",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  },
  // reminders that have come due are emailed within 15 minutes
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "SUPABASE_URL": "https://rqspfymfujfimljgilid.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_UZLXN7SPtreNz2-ZVzoijA_px4mvXhN",
    "AI_GATEWAY": "default",
    "MONS_MODEL": "gemini-3.8-flash",
    "DOMAIN": "heirestates.com",
    "ADMIN_URL": "https://admin.heirestates.com",
    // a verified sender on heirestates.com in Resend
    "MAIL_FROM": "Heir Estates <no-reply@heirestates.com>",
    // Cloudflare dashboard > the account's overview (right-hand column)
    "CF_ACCOUNT_ID": "3c6f10a996d25fa8c2e7d4408d26439c",
    // Meta app > WhatsApp > API Setup: the business number's "Phone number ID" (not the number itself)
    "WA_PHONE_NUMBER_ID": "",
    "WA_GRAPH_VERSION": "v23.0",
    // Google Cloud console > APIs & Services > Credentials: the OAuth "Web application" client's ID.
    // Its authorised redirect URI is https://admin.heirestates.com/api/google/callback
    "GOOGLE_CLIENT_ID": "562480073402-6d77hgjot1r7r2ofh8ernmuqb65c0n3f.apps.googleusercontent.com",
    // push notifications (admin/worker/push.js): the public half of the VAPID key pair; the private
    // half is the VAPID_PRIVATE_KEY secret. Change one, change both, and everyone turns alerts on again.
    "VAPID_PUBLIC_KEY": "BNKa0-gNkBFRbZoj_QXkTO-FJRXGpWWvWy4twy735G5ZmRsH_28XVLe_5joWJmydVHKz2VBM2TIIUjaCpKKpctk"
  }
}
