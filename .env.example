# The admin app (vite.admin.config.js reads these). Both are public by design: row-level security guards the data.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The public sites: the enquiry form's bot check (Cloudflare Turnstile). Empty: the form opens the mail app instead.
VITE_TURNSTILE_SITE_KEY=
